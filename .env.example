# ---------------------------------------------------------------------------
# Kagaz environment variables. Copy to .env and adjust. Never commit .env.
# Names documented in docs/IMPLEMENTATION_PLAN.md, Appendix B.
# ---------------------------------------------------------------------------

# local | demo | staging | production
APP_ENV=local
API_PORT=4000
PUBLIC_WEB_URL=http://localhost:3000

# PostgreSQL (infra/docker-compose.yml)
DATABASE_URL=postgresql://kagaz:kagaz@localhost:5432/kagaz

# S3-compatible private storage (SeaweedFS locally, Cloudflare R2 / AWS S3 in cloud)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=kagaz-local
S3_ACCESS_KEY_ID=kagaz-local
S3_SECRET_ACCESS_KEY=kagaz-local-secret
S3_FORCE_PATH_STYLE=true
UPLOAD_URL_TTL_SECONDS=600
DOWNLOAD_URL_TTL_SECONDS=300

# Order limits
MAX_UPLOAD_BYTES=26214400
MAX_PAGES=300
MAX_COPIES=20
MAX_SIDES=1000

# Providers. "demo" is forbidden when APP_ENV=production (the API refuses to start).
PAYMENT_PROVIDER=demo
OTP_PROVIDER=demo
DEMO_WEBHOOK_SECRET=change-me-demo-webhook-secret
# Demo gateway simulation (P3.5): webhook delivery delay and PENDING → PAID resolve time.
DEMO_WEBHOOK_DELAY_MS=300
DEMO_PENDING_RESOLVE_SECONDS=10

# Secrets (generate real values per environment)
SESSION_JWT_SECRET=change-me-session-secret-at-least-32-chars
PICKUP_CODE_PEPPER=change-me-pickup-pepper-at-least-32-chars
# 32 random bytes, base64. The value below is a LOCAL DEV key (refused in staging/production).
# Generate a real one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PICKUP_CODE_ENC_KEY=Y2hhbmdlLW1lLWxvY2FsLWRldi1rZXktMzJieXRlcyE=

# Seed (pnpm --filter @kagaz/api db:seed). Optional in local/demo.
# SEED_ADMIN_PASSWORD: admin@kagaz.local password (random + printed once when unset).
# SEED_STAFF_PASSWORD: password for the seeded shop owners/operators
#   (owner-a@kagaz.local, operator-a@kagaz.local, … for shops A–C). Defaults to
#   kagaz-demo-123 in local/demo only; required in other environments. Printed by db:seed.
# SEED_STAFF_PASSWORD=

# Print orchestration
PRINTER_LEASE_TTL_SECONDS=60
DEVICE_ONLINE_THRESHOLD_SECONDS=45
# Shop apps older than this get 426 AGENT_UPGRADE_REQUIRED (empty = no minimum).
MIN_AGENT_VERSION=

# Retention
# PDFs are deleted this long after COLLECTED / CANCELLED (PRD §14.3) ...
RETENTION_AFTER_COLLECTED_HOURS=24
# ... and after REJECTED / REFUNDED (7-day dispute window).
RETENTION_AFTER_REJECTED_HOURS=168
UNPAID_ORDER_EXPIRY_HOURS=24

# Observability (optional)
SENTRY_DSN=
LOG_LEVEL=info

# Web (Next.js) — public, safe to expose
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Landing site (apps/landing → kaggaz.app) — public, baked in at build time
# Customer ordering app (apps/web), target of every "Start printing" button.
NEXT_PUBLIC_CUSTOMER_APP_URL=https://print.kaggaz.app
# Public URL of the shop-app release folder (Cloudflare R2), e.g. https://downloads.kaggaz.app/kagaz-shop
# Empty → the download button shows "Coming soon". Keep equal to SHOP_APP_RELEASES_URL below.
NEXT_PUBLIC_SHOP_APP_RELEASES_URL=
# Optional, shown in the footer / "Talk to us" buttons.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Shop app releases (scripts/build-shop-agent-installer.ps1 + pnpm release:shop-agent)
# Same public URL as above: baked into the installed app as UpdateFeedUrl.
SHOP_APP_RELEASES_URL=
# API the installed shop app talks to (ApiBaseUrl), e.g. https://api.kaggaz.app/api. Empty → appsettings default.
SHOP_APP_API_URL=
# Cloudflare R2 (S3 API) credentials for uploading releases. Secret: never NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Folder inside the bucket (optional), e.g. kagaz-shop
R2_PREFIX=
