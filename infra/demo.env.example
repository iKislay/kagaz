# Environment for infra/docker-compose.demo.yml. Copy to infra/demo.env (gitignored: it holds
# secrets) and replace every value marked CHANGE.
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

APP_ENV=demo
IMAGE_TAG=demo

# Public URLs as seen by the BROWSER (also baked into the web image at build time).
PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# S3 endpoint reachable from the browser and from the api container (VM host name / IP).
S3_ENDPOINT=http://host.docker.internal:9000

API_HOST_PORT=4000
WEB_HOST_PORT=3000
S3_HOST_PORT=9000

POSTGRES_PASSWORD=CHANGE-me-postgres
S3_BUCKET=kagaz-demo
# CHANGE both: they become the only S3 identity SeaweedFS accepts in the demo stack.
S3_ACCESS_KEY_ID=CHANGE-me-s3-access-key
S3_SECRET_ACCESS_KEY=CHANGE-me-s3-secret-key-at-least-32-chars

DEMO_WEBHOOK_SECRET=CHANGE-me-demo-webhook-secret
SESSION_JWT_SECRET=CHANGE-me-session-secret-at-least-32-chars

SENTRY_DSN=
LOG_LEVEL=info
