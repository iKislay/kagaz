<Window x:Class="Kagaz.ShopAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/design"
        xmlns:views="clr-namespace:Kagaz.ShopAgent.App.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1080" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#111827"
        d:DesignHeight="720" d:DesignWidth="1080">
    <!-- Resources must be declared before the content that uses them via StaticResource. -->
    <Window.Resources>
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="#D1D5DB" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#374151" />
                    <Setter Property="Foreground" Value="#F9FAFB" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left nav: header (top), connection status (bottom), nav list fills the rest. -->
        <Border Grid.Column="0" Background="#1F2937">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="16,24,16,16">
                    <TextBlock Text="Kagaz Shop" Foreground="#F9FAFB" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding Version}" Foreground="#9CA3AF" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#111827" Padding="12" Margin="12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{Binding ConnectionBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ConnectionText}" Foreground="#F9FAFB"
                                   FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                   MaxWidth="200" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Foreground="#D1D5DB"
                         ItemContainerStyle="{StaticResource NavItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Padding="12,8" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Column="1" Background="#111827" Padding="24">
            <ContentControl Content="{Binding SelectedNavigation}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <views:PlaceholderView />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
    </Grid>
</Window>
