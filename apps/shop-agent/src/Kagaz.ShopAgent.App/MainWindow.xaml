<Window x:Class="Kagaz.ShopAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/design"
        xmlns:views="clr-namespace:Kagaz.ShopAgent.App.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1080" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        d:DesignHeight="720" d:DesignWidth="1080">
    <!-- macOS-style layout (CLAUDE.md "Design language"): source-list sidebar + content. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: header (top), connection status (bottom), nav list fills the rest. -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="10,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,22,8,18">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="K" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Kagaz Shop" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Style="{StaticResource SecondaryText}"
                                   FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="0,8,0,14" Padding="10,8" CornerRadius="8"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding ConnectionBrush}" Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                   MaxWidth="170" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="SHOP" Style="{StaticResource SidebarHeading}" Margin="10,0,0,6" />
                    <ListBox ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                               FontSize="15" Width="20" Margin="0,0,8,0"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1" Margin="36,32,36,32" Content="{Binding SelectedNavigation}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <views:PlaceholderView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</Window>
