<Window x:Class="Kagaz.ShopAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/design"
        xmlns:vm="clr-namespace:Kagaz.ShopAgent.App.ViewModels"
        xmlns:views="clr-namespace:Kagaz.ShopAgent.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding WindowTitle}"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Grid>
    <!-- The shop is ready: macOS-style source-list sidebar + content (CLAUDE.md "Design language"). -->
    <Grid Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: header (top), connection status (bottom), nav list fills the rest. -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="10,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,22,8,18">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="K" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status.ShopName, TargetNullValue=Kaggaz Shop, FallbackValue=Kaggaz Shop}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="160" />
                        <TextBlock Text="{Binding Version, StringFormat=Kaggaz Shop {0}}" Style="{StaticResource SecondaryText}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Signed-in operator (P2.3) -->
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,8" CornerRadius="8"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                        Visibility="{Binding Status.IsOperatorSignedIn, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE77B;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status.OperatorName}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Status.OperatorRole}" Style="{StaticResource SecondaryText}" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Sign out" Style="{StaticResource LinkButton}" FontSize="12"
                                Command="{Binding SignOutCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" Margin="0,8,0,14" Padding="10,8" CornerRadius="8"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding Status.Connection, Converter={StaticResource ConnectionBrush}}" />
                            <TextBlock Text="{Binding Status.ConnectionText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" MaxWidth="170" />
                        </StackPanel>
                        <!-- Read-only approval mode (ADR-002: changed in Settings) -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" ToolTip="Order approval — change it in Settings"
                                    Visibility="{Binding Mode.IsVisible, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE8FB;" Style="{StaticResource IconText}" FontSize="10" Width="10" Margin="-1,0,7,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       AutomationProperties.Name="Order approval mode">
                                <Run Text="Approval:" /> <Run Text="{Binding Mode.Indicator, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="SHOP" Style="{StaticResource SidebarHeading}" Margin="10,0,0,6" />
                    <ListBox ItemsSource="{Binding VisibleNavigationItems}"
                             SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource IconText}"
                                               FontSize="15" Width="20" Margin="0,0,8,0"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Calm amber bar: subscription ending soon, or the shop closed to new orders. -->
            <Border Grid.Row="0" Style="{StaticResource NoticeBar}"
                    Visibility="{Binding BillingNotice, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource OrangeBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding BillingNotice}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AmberTextBrush}"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Printer problems on this PC (P2.10): paper out, offline, error… -->
            <Border Grid.Row="1" Style="{StaticResource NoticeBar}" Background="#14FF3B30" BorderBrush="#26FF3B30"
                    Visibility="{Binding Status.PrinterAlert, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE749;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource RedBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Status.PrinterAlert}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <ContentControl Grid.Row="2" Margin="36,28,36,28" Content="{Binding CurrentPage}" Focusable="False">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:PairingViewModel}">
                        <views:PairingView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PrintersViewModel}">
                        <views:PrintersView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:JobsViewModel}">
                        <views:JobsView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:TodaysPickupsViewModel}">
                        <views:TodaysPickupsView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:StaffViewModel}">
                        <views:StaffView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PricesViewModel}">
                        <views:PricesView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ShopQrViewModel}">
                        <views:ShopQrView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

        </Grid>

    </Grid>

    <!-- Not ready yet (AppGates): one full-window screen — connect this PC, sign in, set up the shop or
         subscribe. No sidebar and no page is reachable until the shop is ready. -->
    <DockPanel Visibility="{Binding IsReady, Converter={StaticResource InverseBoolToVisibility}}">
        <Border DockPanel.Dock="Top" Padding="24,16" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Background="{StaticResource SurfaceBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                             Fill="{Binding Status.Connection, Converter={StaticResource ConnectionBrush}}" />
                    <TextBlock Text="{Binding Status.ConnectionText}" Style="{StaticResource SecondaryText}" FontSize="12"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0"
                                Visibility="{Binding Status.IsOperatorSignedIn, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Status.OperatorName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <Button Content="Sign out" Style="{StaticResource LinkButton}" FontSize="12" Margin="12,0,0,0"
                                Command="{Binding SignOutCommand}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="K" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status.ShopName, TargetNullValue=Kaggaz Shop, FallbackValue=Kaggaz Shop}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding Version, StringFormat=Kaggaz Shop {0}}" Style="{StaticResource SecondaryText}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl Content="{Binding GatePage}" Focusable="False" MaxWidth="640" Margin="24,28,24,0"
                        HorizontalAlignment="Stretch">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:PairingViewModel}">
                    <views:PairingView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:OperatorLoginViewModel}">
                    <views:OperatorLoginView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:SetupViewModel}">
                    <views:SetupView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:SubscriptionViewModel}">
                    <views:SubscriptionView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </DockPanel>

            <!-- Toasts: top-right notification banners -->
            <ItemsControl ItemsSource="{Binding Status.Toasts}" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,72,20,0" Width="320" Focusable="False" IsHitTestVisible="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="14"
                                           Foreground="{StaticResource GreenBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource HeadlineText}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0"
                                               Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource OrangeBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        <!-- "Update required" (P4.4): blocks the whole window while the server says this version is too old. -->
        <Border Background="{StaticResource ScrimBrush}" DataContext="{Binding Update}"
                Visibility="{Binding Status.UpgradeRequired, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Sheet}" MaxWidth="460">
                <StackPanel>
                    <TextBlock Text="&#xE777;" Style="{StaticResource IconText}" FontSize="28" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                    <TextBlock Text="Update required" Style="{StaticResource TitleText}" FontSize="22" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0">
                        <Run Text="This is Kaggaz Shop" />
                        <Run Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". The server needs version" />
                        <Run Text="{Binding Status.MinAgentVersion, Mode=OneWay, TargetNullValue=a newer one}" FontWeight="SemiBold" />
                        <Run Text="or later. No new jobs will print until this PC is updated." />
                    </TextBlock>
                    <TextBlock Text="{Binding UnavailableReason}" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding CanSelfUpdate, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Install update" Style="{StaticResource PrimaryButton}" Command="{Binding InstallUpdateCommand}"
                                Visibility="{Binding CanSelfUpdate, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
