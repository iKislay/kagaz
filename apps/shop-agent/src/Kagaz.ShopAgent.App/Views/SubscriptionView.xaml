<UserControl x:Class="Kagaz.ShopAgent.App.Views.SubscriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/design"
             xmlns:vm="clr-namespace:Kagaz.ShopAgent.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SubscriptionViewModel}"
             d:DesignHeight="600" d:DesignWidth="640">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="30" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" Margin="0,12,0,0" />
            <TextBlock Text="{Binding EndedText}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding EndedText, Converter={StaticResource NullToVisibility}}" />
            <TextBlock Text="{Binding Body}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />

            <!-- Kaggaz contact (from the server config) -->
            <Border Style="{StaticResource Card}" DataContext="{Binding Support}">
                <StackPanel>
                    <StackPanel Visibility="{Binding DisplayPhone, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="Call or WhatsApp Kaggaz" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource QuietButton}" Command="{Binding CopyPhoneCommand}"
                                    VerticalAlignment="Center" />
                            <TextBox Text="{Binding DisplayPhone, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                     AutomationProperties.Name="Kaggaz phone number" />
                        </DockPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding CallCommand}" Margin="0,0,8,8" AutomationProperties.Name="Call Kaggaz">
                                <TextBlock Text="{Binding CallText}" />
                            </Button>
                            <Button Content="WhatsApp us" Style="{StaticResource QuietButton}" Command="{Binding OpenWhatsAppCommand}" Margin="0,0,8,8"
                                    Visibility="{Binding WhatsAppUrl, Converter={StaticResource NullToVisibility}}" />
                        </WrapPanel>
                    </StackPanel>
                    <Button Content="Visit kaggaz.in" Style="{StaticResource LinkButton}" Command="{Binding OpenWebsiteCommand}"
                            HorizontalAlignment="Left" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="I've paid — check again" Style="{StaticResource QuietButton}" Command="{Binding CheckAgainCommand}" />
                <TextBlock Text="Jobs you already accepted keep printing." Style="{StaticResource SecondaryText}" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
