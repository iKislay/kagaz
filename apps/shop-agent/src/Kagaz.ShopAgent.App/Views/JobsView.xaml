<UserControl x:Class="Kagaz.ShopAgent.App.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/design"
             xmlns:vm="clr-namespace:Kagaz.ShopAgent.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:JobsViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Jobs" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,16">
                    <Run Text="Accept paid orders, watch them print, then mark them ready." />
                    <Run Text="{Binding LastUpdated, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Pause printing" IsChecked="{Binding IsPaused}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource QuietButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh now">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tabs + error -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <ListBox AutomationProperties.Name="Job tabs" Style="{StaticResource SegmentedControl}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                     DisplayMemberPath="Title" />
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,10,0,0"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <!-- List + detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <ListBox AutomationProperties.Name="Jobs list" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:JobItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusBrush}}"
                                             VerticalAlignment="Top" Margin="0,6,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding PublicRef}" Style="{StaticResource HeadlineText}" FontSize="14" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding DisplayAmount}" Style="{StaticResource HeadlineText}" FontSize="14" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding DisplayPaidAt}" Style="{StaticResource SecondaryText}" FontSize="11" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="28" Foreground="#40000000" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detail -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DataContext="{Binding SelectedJob}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding PublicRef}" Style="{StaticResource TitleText}" FontSize="22" />
                                <TextBlock Text="{Binding DisplayPaidAt, StringFormat=Paid {0}}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Hairline}" Margin="0,18,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Document" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayPages}" Style="{StaticResource BodyText}" />
                            <TextBlock Grid.Row="1" Text="Print" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyText}">
                                <Run Text="{Binding DisplayRange, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DisplayCopies, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="2" Text="Options" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyText}">
                                <Run Text="{Binding DisplayMode, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DisplaySides, Mode=OneWay}" /><Run Text=" · A4" />
                            </TextBlock>
                            <TextBlock Grid.Row="3" Text="Charged" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource BodyText}">
                                <Run Text="{Binding DisplayAmount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding DisplayPrintedSides, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="4" Text="Payment" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"
                                       Visibility="{Binding IsDemoPayment, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Demo payment — no money charged" Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource AmberTextBrush}"
                                       Visibility="{Binding IsDemoPayment, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Grid.Row="5" Text="Print job" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"
                                       Visibility="{Binding PrintJobDetail, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PrintJobDetail}" Style="{StaticResource BodyText}"
                                       Visibility="{Binding PrintJobDetail, Converter={StaticResource NullToVisibility}}" />
                        </Grid>

                        <Border Background="#14FF3B30" CornerRadius="8" Padding="12,10" Margin="0,8,0,0"
                                Visibility="{Binding PrintError, Converter={StaticResource NullToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource RedBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding PrintError}" Style="{StaticResource BodyText}" MaxWidth="380" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Hairline}" Margin="0,16,0,16" />

                        <WrapPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button Content="Accept" Style="{StaticResource PrimaryButton}" Command="{Binding AcceptCommand}" Margin="0,0,8,8"
                                    Visibility="{Binding SelectedJob.CanAccept, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Mark Ready…" Style="{StaticResource PrimaryButton}" Command="{Binding OpenMarkReadyCommand}" Margin="0,0,8,8"
                                    Visibility="{Binding SelectedJob.CanMarkReady, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Open preview" Style="{StaticResource QuietButton}" Command="{Binding OpenPreviewCommand}" Margin="0,0,8,8" />
                            <Button Content="Reject…" Style="{StaticResource DestructiveButton}" Command="{Binding OpenRejectCommand}" Margin="0,0,8,8"
                                    Visibility="{Binding SelectedJob.CanReject, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Reject sheet -->
        <Border Grid.RowSpan="3" Background="{StaticResource ScrimBrush}" Margin="-36,-28"
                Visibility="{Binding IsRejectOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Sheet}">
                <StackPanel>
                    <TextBlock Text="Reject this order?" Style="{StaticResource TitleText}" FontSize="20" />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,16">
                        <Run Text="{Binding SelectedJob.PublicRef, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="will be cancelled and the customer refunded." />
                    </TextBlock>
                    <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
                    <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                        <ListBox ItemsSource="{Binding RejectReasons}" SelectedItem="{Binding RejectReason}" DisplayMemberPath="Label"
                                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RowItem}" />
                    </Border>
                    <TextBlock Text="Note for the customer (optional)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <TextBox Text="{Binding RejectNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"
                             MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True" Height="64" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Style="{StaticResource QuietButton}" Command="{Binding CancelRejectCommand}" Margin="0,0,10,0" IsCancel="True" />
                        <Button Content="Reject order" Style="{StaticResource PrimaryButton}" Background="{StaticResource RedBrush}" Command="{Binding SubmitRejectCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Mark Ready sheet (FR-SHOP-12: explicit operator confirmation) -->
        <Border Grid.RowSpan="3" Background="{StaticResource ScrimBrush}" Margin="-36,-28"
                Visibility="{Binding IsMarkReadyOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Sheet}">
                <StackPanel>
                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="26" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource TitleText}" FontSize="20" Margin="0,10,0,0">
                        <Run Text="Mark" /> <Run Text="{Binding SelectedJob.PublicRef, Mode=OneWay}" /> <Run Text="ready?" />
                    </TextBlock>
                    <TextBlock Text="The customer is told their prints are ready and can collect them with their pickup code."
                               Style="{StaticResource SecondaryText}" Margin="0,6,0,16" />
                    <CheckBox Style="{StaticResource CheckField}" IsChecked="{Binding MarkReadyChecked}">
                        <TextBlock Text="I have checked the printed stack and the pickup slip" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                    </CheckBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Cancel" Style="{StaticResource QuietButton}" Command="{Binding CancelMarkReadyCommand}" Margin="0,0,10,0" IsCancel="True" />
                        <Button Content="Mark Ready" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmMarkReadyCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
