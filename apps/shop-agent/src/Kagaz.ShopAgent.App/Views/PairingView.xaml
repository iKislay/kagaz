<UserControl x:Class="Kagaz.ShopAgent.App.Views.PairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/design"
             xmlns:vm="clr-namespace:Kagaz.ShopAgent.App.ViewModels"
             xmlns:views="clr-namespace:Kagaz.ShopAgent.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PairingViewModel}"
             d:DesignHeight="760" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">

            <!-- Revoked (P2.4) -->
            <Border Background="#14FF3B30" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                    Visibility="{Binding Status.RevokedNotice, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="16" Foreground="{StaticResource RedBrush}"
                               Margin="0,0,10,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{Binding Status.RevokedNotice}" Style="{StaticResource HeadlineText}" />
                        <TextBlock Text="This PC was disconnected from your shop. Sign in again with your shop's mobile number to reconnect it."
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" MaxWidth="460" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Paired -->
            <StackPanel Visibility="{Binding Status.IsPaired, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="This PC" Style="{StaticResource TitleText}" />
                <TextBlock Text="This PC receives your shop's Kaggaz orders and prints them." Style="{StaticResource SubtitleText}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#1F34C759">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status.ShopName, StringFormat=Connected to {0}}" Style="{StaticResource HeadlineText}" />
                                <TextBlock Text="{Binding DeviceName, StringFormat=This PC: {0}}" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource Hairline}" />
                        <TextBlock Text="This PC's access key is stored securely for this Windows user."
                                   Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,0,0,16" />
                        <Button Content="Disconnect this PC" Style="{StaticResource DestructiveButton}" HorizontalAlignment="Left"
                                Command="{Binding UnpairCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Not paired: first-run welcome -->
            <StackPanel Visibility="{Binding Status.IsPaired, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="K" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Welcome to Kaggaz Shop" Style="{StaticResource TitleText}" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Customers send their files from their phones. Kaggaz prints them on your shop printer, each with a pickup slip, and they pay you at the counter."
                           Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="0,10,0,18" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                            Visibility="{Binding IsCode, Converter={StaticResource InverseBoolToVisibility}}">
                    <Button Content="Sign in" Command="{Binding ShowSignInCommand}" Style="{StaticResource ChoiceButton}" Tag="{Binding IsSignIn}" Margin="0,0,8,0" />
                    <Button Content="Create shop account" Command="{Binding ShowSignUpCommand}" Style="{StaticResource ChoiceButton}" Tag="{Binding IsSignUp}" />
                </StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Sign in -->
                        <StackPanel Visibility="{Binding IsSignIn, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Sign in with your shop's mobile number" Style="{StaticResource HeadlineText}" Margin="0,0,0,12" />
                            <TextBlock Text="Mobile number" Style="{StaticResource FieldLabel}" />
                            <TextBox AutomationProperties.Name="Mobile number" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}" MaxLength="20" />
                            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                            <PasswordBox x:Name="SignInPassword" AutomationProperties.Name="Password" PasswordChanged="OnPasswordChanged"
                                         Style="{StaticResource PasswordField}" MaxLength="200" />
                            <StackPanel Visibility="{Binding HasShopChoices, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                                <TextBlock Text="Shop for this PC" Style="{StaticResource FieldLabel}" />
                                <ComboBox AutomationProperties.Name="Shop for this PC" ItemsSource="{Binding ShopChoices}"
                                          SelectedItem="{Binding SelectedShop}" MinWidth="260" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Button Content="Sign in" Style="{StaticResource PrimaryButton}" Command="{Binding SignInCommand}"
                                    IsDefault="{Binding IsSignIn}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                        </StackPanel>

                        <!-- Create shop account -->
                        <StackPanel Visibility="{Binding IsSignUp, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Create your shop account" Style="{StaticResource HeadlineText}" />
                            <TextBlock Text="Takes a minute. You'll sign in with your mobile number from now on."
                                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,12" />
                            <TextBlock Text="Shop name" Style="{StaticResource FieldLabel}" />
                            <TextBox AutomationProperties.Name="Shop name" Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}" MaxLength="120" />
                            <TextBlock Text="Your name" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                            <TextBox AutomationProperties.Name="Your name" Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}" MaxLength="80" />
                            <TextBlock Text="Mobile number" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                            <TextBox AutomationProperties.Name="Mobile number for the shop" Text="{Binding SignUpPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}" MaxLength="20" />
                            <TextBlock Text="Password (at least 8 characters)" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                            <PasswordBox x:Name="SignUpPassword" AutomationProperties.Name="Password" PasswordChanged="OnSignUpPasswordChanged"
                                         Style="{StaticResource PasswordField}" MaxLength="200" />
                            <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                            <PasswordBox x:Name="SignUpConfirm" AutomationProperties.Name="Confirm password" PasswordChanged="OnSignUpConfirmChanged"
                                         Style="{StaticResource PasswordField}" MaxLength="200" />
                            <Button Content="Create shop account" Style="{StaticResource PrimaryButton}" Command="{Binding SignUpCommand}"
                                    IsDefault="{Binding IsSignUp}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                        </StackPanel>

                        <!-- Pairing code (fallback) -->
                        <StackPanel Visibility="{Binding IsCode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Connect with a pairing code" Style="{StaticResource HeadlineText}" />
                            <TextBlock Text="Only if Kaggaz support gave you a code." Style="{StaticResource SecondaryText}" Margin="0,2,0,12" />
                            <TextBlock Text="Pairing code" Style="{StaticResource FieldLabel}" />
                            <TextBox AutomationProperties.Name="Pairing code" Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="18" MaxLength="16" />
                            <TextBlock Text="Looks like ABCD-EFGH. Each code works once." Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,0" />
                            <Button Content="Connect this PC" Style="{StaticResource PrimaryButton}" Command="{Binding PairCommand}"
                                    IsDefault="{Binding IsCode}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                            <Button Content="Back to sign in" Style="{StaticResource LinkButton}" Command="{Binding ShowSignInCommand}"
                                    HorizontalAlignment="Left" Margin="0,14,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="Please wait…" Style="{StaticResource SecondaryText}" Margin="0,10,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                        <Border Style="{StaticResource Hairline}" Margin="0,18,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Have a pairing code from Kaggaz support?" Style="{StaticResource LinkButton}" FontSize="12"
                                    Command="{Binding ShowCodeCommand}" Margin="0,0,18,0"
                                    Visibility="{Binding IsCode, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Button Content="Advanced" Style="{StaticResource LinkButton}" FontSize="12" Command="{Binding ToggleAdvancedCommand}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                            <TextBlock Text="Name for this PC" Style="{StaticResource FieldLabel}" />
                            <TextBox AutomationProperties.Name="Name for this PC" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}" MaxLength="80" />
                            <TextBlock Text="Server address (only change this if Kaggaz support asks you to)" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                            <TextBox AutomationProperties.Name="Server address" Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <views:SupportCard DataContext="{Binding Support}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
