<UserControl x:Class="Kagaz.ShopAgent.App.Views.PairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/design"
             xmlns:vm="clr-namespace:Kagaz.ShopAgent.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PairingViewModel}"
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Pairing" Style="{StaticResource TitleText}" />
            <TextBlock Text="Connect this PC to your Kagaz shop with the one-time code from the Kagaz team."
                       Style="{StaticResource SubtitleText}" />

            <!-- Paired -->
            <Border Style="{StaticResource Card}" Visibility="{Binding Status.IsPaired, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#1F34C759">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status.ShopName, StringFormat=Paired with {0}}" Style="{StaticResource HeadlineText}" />
                            <TextBlock Text="{Binding DeviceName, StringFormat=This PC: {0}}" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource Hairline}" />
                    <TextBlock Text="Server" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding ApiUrl}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="The device token is stored encrypted for this Windows user (DPAPI)."
                               Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,12,0,16" />
                    <Button Content="Unpair this PC" Style="{StaticResource DestructiveButton}" HorizontalAlignment="Left"
                            Command="{Binding UnpairCommand}" />
                </StackPanel>
            </Border>

            <!-- Not paired -->
            <Border Style="{StaticResource Card}" Visibility="{Binding Status.IsPaired, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Server address" Style="{StaticResource FieldLabel}" />
                    <TextBox AutomationProperties.Name="Server address" Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}" />

                    <TextBlock Text="Pairing code" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <TextBox AutomationProperties.Name="Pairing code" Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"
                             FontFamily="{StaticResource MonoFont}" FontSize="18" MaxLength="16" />
                    <TextBlock Text="Looks like ABCD-EFGH. Each code works once." Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,0" />

                    <TextBlock Text="Name for this PC" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <TextBox AutomationProperties.Name="Name for this PC" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}" MaxLength="80" />

                    <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,14,0,0"
                               Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Pair this PC" Style="{StaticResource PrimaryButton}" Command="{Binding PairCommand}" IsDefault="True" />
                        <TextBlock Text="Pairing…" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding IsPairing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
