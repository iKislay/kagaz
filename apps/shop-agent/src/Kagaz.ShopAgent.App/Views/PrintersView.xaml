<UserControl x:Class="Kagaz.ShopAgent.App.Views.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/design"
             xmlns:vm="clr-namespace:Kagaz.ShopAgent.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PrintersViewModel}"
             d:DesignHeight="600" d:DesignWidth="800"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Printers" Style="{StaticResource TitleText}" />
            <TextBlock Text="Choose the printer Kaggaz orders print on and confirm what it can really do. Kaggaz never sends a colour or double-sided order to a printer you haven't confirmed for it."
                       Style="{StaticResource SubtitleText}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*" MaxWidth="720" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ItemsControl ItemsSource="{Binding Printers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PrinterChoice}">
                        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE749;" Style="{StaticResource IconText}" FontSize="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,14,0" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PrinterName}" Style="{StaticResource HeadlineText}" />
                                            <Border Style="{StaticResource StatusPill}" Margin="10,0,0,0" Padding="7,1"
                                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" Background="#1A007AFF">
                                                <TextBlock Text="Default" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DriverSummary}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" Content="Use for Kaggaz" IsChecked="{Binding IsUsed}" />
                                </Grid>

                                <StackPanel Visibility="{Binding IsUsed, Converter={StaticResource BoolToVisibility}}" Margin="34,4,0,0">
                                    <Border Style="{StaticResource Hairline}" Margin="0,10" />
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Prints in colour" IsChecked="{Binding ColourCapable}" Margin="0,0,0,10" />
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Prints double-sided (automatic duplex)" IsChecked="{Binding DuplexCapable}" Margin="0,0,0,12" />
                                    <CheckBox Style="{StaticResource CheckField}" IsChecked="{Binding CapabilitiesConfirmed}" Margin="0,0,0,10">
                                        <TextBlock Text="I printed a test page and colour, double-sided and A4 behave as set above."
                                                   Style="{StaticResource BodyText}" />
                                    </CheckBox>
                                    <Button Content="Make default printer" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.MakeDefaultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Save printers" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
            <Button Content="Refresh list" Style="{StaticResource QuietButton}" Command="{Binding LoadCommand}" Margin="10,0,0,0" />
            <TextBlock Text="{Binding SeatsText}" Style="{StaticResource SecondaryText}" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"
                       Visibility="{Binding SeatsText, Converter={StaticResource NullToVisibility}}" />
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="420">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
