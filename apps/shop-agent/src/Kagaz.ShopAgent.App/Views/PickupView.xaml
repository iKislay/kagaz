<UserControl x:Class="Kagaz.ShopAgent.App.Views.PickupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/design"
             xmlns:vm="clr-namespace:Kagaz.ShopAgent.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PickupViewModel}"
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Pickup" Style="{StaticResource TitleText}" />
            <TextBlock Text="Type the 8-character code the customer shows you. It matches the code on the pickup slip and works once."
                       Style="{StaticResource SubtitleText}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Pickup code" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="CodeBox" AutomationProperties.Name="Pickup code" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"
                             FontFamily="{StaticResource MonoFont}" FontSize="28" Padding="12,10" MaxLength="12"
                             HorizontalContentAlignment="Center" CharacterCasing="Upper" />
                    <TextBlock Text="Spaces and dashes are ignored." Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Verify code" Style="{StaticResource PrimaryButton}" Command="{Binding VerifyCommand}" IsDefault="True" />
                        <Button Content="Clear" Style="{StaticResource QuietButton}" Command="{Binding ClearCommand}" Margin="10,0,0,0" />
                    </StackPanel>

                    <!-- Error -->
                    <Border Background="#14FF3B30" CornerRadius="8" Padding="14,12" Margin="0,18,0,0"
                            Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource RedBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Error}" Style="{StaticResource BodyText}" MaxWidth="380" />
                        </StackPanel>
                    </Border>

                    <!-- Success -->
                    <Border Background="#1A34C759" CornerRadius="10" Padding="16,14" Margin="0,18,0,0"
                            Visibility="{Binding Collected, Converter={StaticResource NullToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource GreenBrush}" VerticalAlignment="Top">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="15" Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource HeadlineText}">
                                    <Run Text="{Binding Collected.PublicRef, Mode=OneWay}" /><Run Text=" — collected" />
                                </TextBlock>
                                <TextBlock Text="{Binding CollectedSummary}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                                <TextBlock Text="Hand over the stack with the pickup slip on top." Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
