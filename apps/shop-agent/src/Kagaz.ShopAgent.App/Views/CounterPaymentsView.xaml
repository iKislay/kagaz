<UserControl x:Class="Kagaz.ShopAgent.App.Views.CounterPaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Kagaz.ShopAgent.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CounterPaymentsViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">
    <!-- ADR-003: the customer shows their pickup number (#7); the operator collects the amount and approves. -->
    <Grid MaxWidth="760" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Counter payments" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,16">
                    <Run Text="{Binding CountsText, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run Text="{Binding LastUpdated, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource QuietButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh now"
                    VerticalAlignment="Top" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- The customer's pickup number -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24,20">
            <StackPanel>
                <TextBlock Text="Customer's pickup number" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NumberBox" AutomationProperties.Name="Pickup number" Style="{StaticResource TextField}"
                             Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" FontSize="28" FontFamily="{StaticResource DisplayFont}"
                             Padding="16,10,12,10" MaxLength="6" KeyDown="OnNumberKeyDown" />
                    <TextBlock Text="e.g. 7" Style="{StaticResource SecondaryText}" FontSize="20"
                               Margin="17,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Visibility="{Binding HasNumber, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Button Grid.Column="1" Content="Find" Style="{StaticResource PrimaryButton}" Command="{Binding FindCommand}"
                            Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="80" />
                </Grid>
                <TextBlock Text="Or pick the customer from the list below." Style="{StaticResource SecondaryText}" FontSize="12" Margin="2,8,0,0" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="2,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- What to collect -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="24,20"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Result.DisplayPickupNumber}" FontFamily="{StaticResource DisplayFont}" FontSize="48" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Result.DisplayAmount, StringFormat=Collect {0}}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding Result.Summary}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Result.DisplayPickupDate}" Style="{StaticResource SecondaryText}" FontSize="12" HorizontalAlignment="Right"
                                   Visibility="{Binding Result.DisplayPickupDate, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="{Binding Result.DisplayRequestedAt}" Style="{StaticResource SecondaryText}" FontSize="12" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="Payment received — Approve" Style="{StaticResource PrimaryButton}" Command="{Binding ApproveCommand}" />
                    <Button Content="Clear" Style="{StaticResource QuietButton}" Command="{Binding ClearCommand}" Margin="10,0,0,0" />
                    <Button Content="Customer left — cancel" Style="{StaticResource DestructiveButton}" Command="{Binding CancelRequestCommand}"
                            Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Who is waiting -->
        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <TextBlock Text="Waiting at the counter" Style="{StaticResource HeadlineText}" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <ListBox AutomationProperties.Name="Waiting counter payments" ItemsSource="{Binding Waiting}"
                             SelectedItem="{Binding SelectedWaiting}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CounterRequestItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayPickupNumber}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding DisplayPickupDate}" Style="{StaticResource SecondaryText}" FontSize="11"
                                                   Visibility="{Binding DisplayPickupDate, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayAmount, StringFormat=Collect {0}}" Style="{StaticResource HeadlineText}" FontSize="15" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayRequestedAt}" Style="{StaticResource SecondaryText}"
                                               FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <Button Grid.Column="3" Content="Cancel" Style="{StaticResource LinkButton}" FontSize="12" Margin="14,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.CancelWaitingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="28" Foreground="#40000000" HorizontalAlignment="Center" />
                        <TextBlock Text="No one is waiting to pay at the counter." Style="{StaticResource SecondaryText}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
