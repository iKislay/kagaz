<Window x:Class="Kagaz.ShopAgent.App.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/design"
        xmlns:vm="clr-namespace:Kagaz.ShopAgent.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:JobsViewModel}"
        Title="{Binding SelectedJob.PublicRef, StringFormat=Preview · {0}}"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#1C1C1E" FontFamily="{StaticResource UiFont}" KeyDown="OnKeyDown">
    <!-- Full-screen page viewer: ← → change page, Esc or a click outside the page closes. -->
    <Grid MouseLeftButtonUp="OnBackgroundClicked">
        <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="96,64,96,40"
               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Document page"
               MouseLeftButtonUp="OnPageClicked" />
        <TextBlock Text="{Binding PreviewMessage}" Foreground="#A1A1A6" FontSize="15"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Foreground="#F5F5F7" FontSize="14">
            <Run Text="{Binding SelectedJob.PublicRef, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text="·" Foreground="#A1A1A6" />
            <Run Text="{Binding PreviewPageText, Mode=OneWay}" Foreground="#A1A1A6" />
        </TextBlock>
        <Button Style="{StaticResource QuietButton}" Padding="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,20,0"
                Click="OnCloseClicked" AutomationProperties.Name="Close" ToolTip="Close (Esc)" IsCancel="True">
            <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="12" />
        </Button>
        <Button Style="{StaticResource QuietButton}" Padding="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0"
                Command="{Binding PreviousPageCommand}" AutomationProperties.Name="Previous page" ToolTip="Previous page (←)">
            <TextBlock Text="&#xE76B;" Style="{StaticResource IconText}" FontSize="16" />
        </Button>
        <Button Style="{StaticResource QuietButton}" Padding="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0"
                Command="{Binding NextPageCommand}" AutomationProperties.Name="Next page" ToolTip="Next page (→)">
            <TextBlock Text="&#xE76C;" Style="{StaticResource IconText}" FontSize="16" />
        </Button>
    </Grid>
</Window>
