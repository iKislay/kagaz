<UserControl x:Class="Kagaz.ShopAgent.App.Views.PricesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/design"
             xmlns:vm="clr-namespace:Kagaz.ShopAgent.App.ViewModels"
             xmlns:local="clr-namespace:Kagaz.ShopAgent.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PricesViewModel}"
             d:DesignHeight="700" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Prices" Style="{StaticResource TitleText}" />
            <TextBlock Text="What customers pay per printed side, in rupees. Customers see the new prices for new orders."
                       Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <local:PriceFields />

                    <Button Content="Save prices" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                            HorizontalAlignment="Left" Margin="0,20,0,0" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
