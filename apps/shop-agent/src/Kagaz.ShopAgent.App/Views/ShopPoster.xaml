<UserControl x:Class="Kagaz.ShopAgent.App.Views.ShopPoster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/design"
             xmlns:vm="clr-namespace:Kagaz.ShopAgent.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShopQrViewModel}"
             Width="794" Height="1123" Background="White" TextOptions.TextFormattingMode="Ideal">
    <!-- One A4 page (96 DIP/inch) for the shop counter. Fixed light colours: it is printed on white paper. -->
    <Grid Margin="80,84,80,72">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="11" Background="#007AFF">
                <TextBlock Text="K" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Kagaz" Margin="12,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                       Foreground="#1D1D1F" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Scan to print" Margin="0,56,0,0" HorizontalAlignment="Center"
                   FontFamily="{StaticResource DisplayFont}" FontSize="80" FontWeight="Bold" Foreground="#1D1D1F" />
        <TextBlock Grid.Row="2" Text="Send your PDF from your phone. Pay, then collect it here." Margin="0,14,0,0"
                   HorizontalAlignment="Center" FontFamily="{StaticResource UiFont}" FontSize="22" Foreground="#6E6E73" />

        <!-- Soft tinted plate around a white card: the quiet zone stays pure white. -->
        <Border Grid.Row="3" Margin="0,48,0,0" Width="540" Height="540" CornerRadius="44" Background="#F2F6FF"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Margin="40" CornerRadius="28" Background="White" BorderBrush="#DCE6F9" BorderThickness="2" Padding="34">
                <Path Data="{Binding Qr}" Fill="#1D1D1F" Stretch="Uniform" SnapsToDevicePixels="True" />
            </Border>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,40,0,0" HorizontalAlignment="Center">
            <TextBlock Text="{Binding ShopName}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600"
                       FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Foreground="#1D1D1F" />
            <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0" FontFamily="{StaticResource UiFont}" FontSize="19" Foreground="#6E6E73">
                <Run Text="1  Scan" FontWeight="SemiBold" Foreground="#007AFF" />
                <Run Text="    ·    " />
                <Run Text="2  Upload &amp; pay" FontWeight="SemiBold" Foreground="#007AFF" />
                <Run Text="    ·    " />
                <Run Text="3  Collect with your pickup code" FontWeight="SemiBold" Foreground="#007AFF" />
            </TextBlock>
        </StackPanel>

        <TextBlock Grid.Row="5" Text="{Binding DisplayUrl}" Margin="0,28,0,0" HorizontalAlignment="Center"
                   FontFamily="{StaticResource MonoFont}" FontSize="16" Foreground="#8E8E93" />
    </Grid>
</UserControl>
