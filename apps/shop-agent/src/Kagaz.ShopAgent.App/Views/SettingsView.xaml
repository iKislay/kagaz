<UserControl x:Class="Kagaz.ShopAgent.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/design"
             xmlns:vm="clr-namespace:Kagaz.ShopAgent.App.ViewModels"
             xmlns:views="clr-namespace:Kagaz.ShopAgent.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleText}" />
            <TextBlock Text="How this shop takes orders, plus connection and app details for support." Style="{StaticResource SubtitleText}" />

            <!-- Order approval (ADR-002): a shop setting; reflects the heartbeat / socket state, PATCHes only on operator changes. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" DataContext="{Binding Mode}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Order approval" Style="{StaticResource HeadlineText}" />
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,14">
                        <Run Text="Auto:" FontWeight="SemiBold" /><Run Text=" paid orders print automatically when the printer can do them." />
                        <LineBreak />
                        <Run Text="Manual:" FontWeight="SemiBold" /><Run Text=" you accept each order." />
                    </TextBlock>
                    <ListBox AutomationProperties.Name="Order approval" Style="{StaticResource SegmentedControl}" HorizontalAlignment="Left"
                             ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                             IsEnabled="{Binding CanChange}" />
                    <StackPanel Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Hairline}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoPaused, Mode=TwoWay}" IsEnabled="{Binding CanChange}">
                            <StackPanel>
                                <TextBlock Text="Pause auto-accept" Style="{StaticResource HeadlineText}" FontSize="14" />
                                <TextBlock Text="New orders wait for you to accept them until you turn this off."
                                           Style="{StaticResource SecondaryText}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock Text="Orders the printer can't do (colour on a black &amp; white printer, printer offline, too large) always wait for you."
                               Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Shop" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.ShopName, TargetNullValue=Not paired}" Style="{StaticResource BodyText}" />
                    <TextBlock Grid.Row="1" Text="Connection" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding Status.Connection, Converter={StaticResource ConnectionBrush}}" />
                        <TextBlock Text="{Binding Status.ConnectionText}" Style="{StaticResource BodyText}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="Server" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Settings.ApiBaseUrl}" Style="{StaticResource BodyText}" />
                    <TextBlock Grid.Row="3" Text="Checks for jobs" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Settings.PollIntervalSeconds, StringFormat=Every {0} seconds}" Style="{StaticResource BodyText}" />
                    <TextBlock Grid.Row="4" Text="App version" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Version}" Style="{StaticResource BodyText}" />
                    <TextBlock Grid.Row="5" Text="Local data" Style="{StaticResource SecondaryText}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding StatePath}" Style="{StaticResource BodyText}" />
                </Grid>
            </Border>

            <!-- Startup + updates (P5.4) -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Text="Start with Windows" Style="{StaticResource HeadlineText}" FontSize="14" />
                            <TextBlock Text="Open Kaggaz Shop automatically when you sign in to this PC."
                                       Style="{StaticResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="{Binding StartupMessage}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,0"
                               Visibility="{Binding StartupMessage, Converter={StaticResource NullToVisibility}}" />
                    <Border Style="{StaticResource Hairline}" />
                    <TextBlock Text="Updates" Style="{StaticResource HeadlineText}" FontSize="14" />
                    <TextBlock Text="{Binding Update.UnavailableReason}" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding Update.CanSelfUpdate, Converter={StaticResource InverseBoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding Update.CanSelfUpdate, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Check for updates" Style="{StaticResource QuietButton}" Command="{Binding Update.CheckForUpdatesCommand}" />
                        <Button Content="Install update" Style="{StaticResource QuietButton}" Command="{Binding Update.InstallUpdateCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Update.Message}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Update.Message, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Device token rotation (P2.4) -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding Status.IsPaired, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Security key" Style="{StaticResource HeadlineText}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,14" TextWrapping="Wrap">
                        <Run Text="{Binding RotationPolicy, Mode=OneWay}" />
                        <Run Text="Last renewed:" />
                        <Run Text="{Binding LastRotated, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Renew now" Style="{StaticResource QuietButton}" Command="{Binding RotateTokenCommand}" />
                        <TextBlock Text="{Binding RotationMessage}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="380"
                                   Visibility="{Binding RotationMessage, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Subscription" Style="{StaticResource HeadlineText}" />
                    <TextBlock Text="{Binding PlanText}" Style="{StaticResource BodyText}" Margin="0,4,0,2" />
                    <TextBlock Text="Kaggaz is billed per connected printer. To change your plan, contact Kaggaz support."
                               Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" />
                    <Border Style="{StaticResource Hairline}" />
                    <TextBlock Text="Help &amp; support" Style="{StaticResource HeadlineText}" />
                    <TextBlock Text="Questions about your account, logins, printers or billing? We're here to help."
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,14" />
                    <views:SupportCard DataContext="{Binding Support}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Troubleshooting" Style="{StaticResource HeadlineText}" />
                    <TextBlock Text="Logs never contain tokens or download links."
                               Style="{StaticResource SecondaryText}" Margin="0,4,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open logs folder" Style="{StaticResource QuietButton}" Command="{Binding OpenLogsCommand}" />
                        <Button Content="Open “Print to PDF” output" Style="{StaticResource QuietButton}" Command="{Binding OpenPrintToPdfCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
