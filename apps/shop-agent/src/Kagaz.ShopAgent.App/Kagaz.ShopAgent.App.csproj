<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Tray icon + new-order notifications (System.Windows.Forms.NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Kagaz.ShopAgent.App</RootNamespace>
    <AssemblyName>Kagaz.ShopAgent.App</AssemblyName>
    <!-- Single source of the app version (heartbeat, X-Agent-Version, installer). The installer
         script overrides it with -p:Version=x.y.z; AssemblyVersion/FileVersion follow it. -->
    <Version>0.2.0</Version>
    <!-- Program.Main runs Velopack's hooks before WPF starts (P5.4). -->
    <StartupObject>Kagaz.ShopAgent.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is only for the tray icon: keep its names (Application, UserControl…) out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Kagaz.ShopAgent.Core/Kagaz.ShopAgent.Core.csproj" />
    <ProjectReference Include="../Kagaz.ShopAgent.Printing/Kagaz.ShopAgent.Printing.csproj" />
    <!-- Ships Kagaz.ShopAgent.PrintHost.exe next to the app; printing runs in that process. -->
    <ProjectReference Include="../Kagaz.ShopAgent.PrintHost/Kagaz.ShopAgent.PrintHost.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
