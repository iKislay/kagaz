// Kagaz database schema.
// Phase 0: connection only. The full entity set (docs/PRD.md §10) lands in stage P1.1.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}
