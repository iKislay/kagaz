{
  "name": "@kagaz/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared enums, schemas, DTO types and helpers for Kagaz (api + web).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "vitest": "^5"
  }
}
